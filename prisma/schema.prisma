generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Destination {
  id              String            @id @default(uuid())
  description     String
  season          Season
  isActive        Boolean           @default(true)
  addressId       String

  createdById     String?
  updatedById     String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  address         Address           @relation("DestinationAddress", fields: [addressId], references: [id])
  accommodations  Accommodation[]   @relation("DestinationAccommodations")

  createdBy       User?             @relation("DestinationCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?             @relation("DestinationUpdatedBy", fields: [updatedById], references: [id])

  @@index([season])
  @@index([isActive])
  @@index([addressId])
  @@index([createdById])
  @@index([updatedById])
}

model Activity {
  id               String            @id @default(uuid())
  title            String            @unique
  isActive         Boolean           @default(true)
  price            Float
  discount         Float?
  currencyId       String
  addressId        String
  activityTypeId   String

  createdById      String?
  updatedById      String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  activityType     ActivityType      @relation("ActivityActivityType", fields: [activityTypeId], references: [id])
  address          Address           @relation("ActivityAddress", fields: [addressId], references: [id])
  currency         Currency          @relation("ActivityCurrency", fields: [currencyId], references: [id])

  createdBy        User?             @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?             @relation("ActivityUpdatedBy", fields: [updatedById], references: [id])

  @@unique([title, activityTypeId])
  @@index([isActive])
  @@index([activityTypeId])
  @@index([currencyId])
  @@index([addressId])
  @@index([createdById])
  @@index([updatedById])
}

model Address {
  id               String            @id @default(uuid())
  country          String
  countryCode      String
  city             String
  details          String
  latitude         Float?
  longitude        Float?

  createdById      String?
  updatedById      String?

  activities       Activity[]        @relation("ActivityAddress")
  destinations     Destination[]     @relation("DestinationAddress")
  accommodations   Accommodation[]   @relation("AccommodationAddress")

  createdBy        User?             @relation("AddressCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?             @relation("AddressUpdatedBy", fields: [updatedById], references: [id])

  @@unique([countryCode, city, details])
  @@index([countryCode])
  @@index([city])
  @@index([createdById])
  @@index([updatedById])
}

model Currency {
  id               String            @id @default(uuid())
  title            String            @default("United States Dollar")
  symbol           String            @default("$")
  isoCode          String            @default("USD")
  isActive         Boolean           @default(true)

  createdById      String?
  updatedById      String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  activities       Activity[]        @relation("ActivityCurrency")
  houses           House[]           @relation("HouseCurrency")
  rooms            Room[]            @relation("RoomCurrency")

  createdBy        User?             @relation("CurrencyCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?             @relation("CurrencyUpdatedBy", fields: [updatedById], references: [id])

  @@unique([title, isoCode])
  @@index([title])
  @@index([isActive])
  @@index([createdById])
  @@index([updatedById])
}

model ActivityType {
  id               String            @id @default(uuid())
  name             String
  title            String
  emoji            String?
  icon             String            @default("IconQuestionMark")
  isActive         Boolean           @default(true)

  createdById      String?
  updatedById      String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  activities       Activity[]        @relation("ActivityActivityType")

  createdBy        User?             @relation("ActivityTypeCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?             @relation("ActivityTypeUpdatedBy", fields: [updatedById], references: [id])

  @@unique([name, title])
  @@index([name])
  @@index([isActive])
  @@index([createdById])
  @@index([updatedById])
}

model Accommodation {
  id               String               @id @default(uuid())
  type             AccommodationType
  title            String               @unique
  description      String
  addressId        String
  destinationId    String?
  amenities        Json
  policies         Json

  createdById      String?
  updatedById      String?

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  hotel            Hotel?               @relation("AccommodationHotel")
  house            House?               @relation("AccommodationHouse")

  address          Address              @relation("AccommodationAddress", fields: [addressId], references: [id])
  destination      Destination?         @relation("DestinationAccommodations", fields: [destinationId], references: [id])

  createdBy        User?                @relation("AccommodationCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?                @relation("AccommodationUpdatedBy", fields: [updatedById], references: [id])

  @@unique([title, addressId])
  @@index([type])
  @@index([addressId])
  @@index([destinationId])
  @@index([createdById])
  @@index([updatedById])
}

model House {
  id               String            @id @default(uuid())
  accommodationId  String            @unique

  price            Float
  discount         Float?
  capacity         Int
  area             Int
  bathrooms        Int
  bedrooms         Int
  floors           Int
  availableDates   Json?

  currencyId       String

  createdById      String?
  updatedById      String?

  accommodation    Accommodation     @relation("AccommodationHouse", fields: [accommodationId], references: [id], onDelete: Cascade)
  currency         Currency          @relation("HouseCurrency", fields: [currencyId], references: [id])

  createdBy        User?             @relation("HouseCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?             @relation("HouseUpdatedBy", fields: [updatedById], references: [id])

  @@index([currencyId])
  @@index([createdById])
  @@index([updatedById])
}

model Hotel {
  id               String            @id @default(uuid())
  accommodationId  String            @unique

  createdById      String?
  updatedById      String?

  accommodation    Accommodation     @relation("AccommodationHotel", fields: [accommodationId], references: [id], onDelete: Cascade)
  rooms            Room[]            @relation("HotelRooms")

  createdBy        User?             @relation("HotelCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?             @relation("HotelUpdatedBy", fields: [updatedById], references: [id])

  @@index([createdById])
  @@index([updatedById])
}

model Room {
  id               String            @id @default(uuid())
  title            String
  count            Int
  area             Int
  price            Float
  discount         Float?
  capacity         Int
  bedrooms         Int
  bathrooms        Int
  amenities        Json
  beds             Json

  hotelId          String
  currencyId       String

  createdById      String?
  updatedById      String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  hotel            Hotel             @relation("HotelRooms", fields: [hotelId], references: [id], onDelete: Cascade)
  currency         Currency          @relation("RoomCurrency", fields: [currencyId], references: [id])

  createdBy        User?             @relation("RoomCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?             @relation("RoomUpdatedBy", fields: [updatedById], references: [id])

  @@unique([hotelId, title])
  @@index([hotelId])
  @@index([currencyId])
  @@index([createdById])
  @@index([updatedById])
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  password      String?
  username      String?         @unique

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  accounts      Account[]
  sessions      Session[]

  destinationsCreated   Destination[]   @relation("DestinationCreatedBy")
  destinationsUpdated   Destination[]   @relation("DestinationUpdatedBy")

  activitiesCreated     Activity[]      @relation("ActivityCreatedBy")
  activitiesUpdated     Activity[]      @relation("ActivityUpdatedBy")

  addressesCreated      Address[]       @relation("AddressCreatedBy")
  addressesUpdated      Address[]       @relation("AddressUpdatedBy")

  currenciesCreated     Currency[]      @relation("CurrencyCreatedBy")
  currenciesUpdated     Currency[]      @relation("CurrencyUpdatedBy")

  activityTypesCreated  ActivityType[]  @relation("ActivityTypeCreatedBy")
  activityTypesUpdated  ActivityType[]  @relation("ActivityTypeUpdatedBy")

  accommodationsCreated Accommodation[] @relation("AccommodationCreatedBy")
  accommodationsUpdated Accommodation[] @relation("AccommodationUpdatedBy")

  housesCreated         House[]         @relation("HouseCreatedBy")
  housesUpdated         House[]         @relation("HouseUpdatedBy")

  hotelsCreated         Hotel[]         @relation("HotelCreatedBy")
  hotelsUpdated         Hotel[]         @relation("HotelUpdatedBy")

  roomsCreated          Room[]          @relation("RoomCreatedBy")
  roomsUpdated          Room[]          @relation("RoomUpdatedBy")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AccommodationType {
  HOUSE
  HOTEL
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
}
